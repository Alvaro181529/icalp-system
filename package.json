{
  "name": "sistemaicalp",
  "version": "1.0.0",
  "description": "sistema colegio de abogados",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "start:min": "node dist/main.obf.js",
    "dev": "nodemon src/main.js",
    "build": "esbuild src/main.js --bundle --platform=node --external:mysql --outfile=dist/main.js --minify",
    "obfuscate": "javascript-obfuscator dist/main.js --output dist/main.obf.js",
    "prod": "npm run build && npm run obfuscate"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^8.2.0",
    "ejs": "^3.1.5",
    "express": "^4.17.1",
    "google-auth-library": "^10.1.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "mssql": "^7.1.1",
    "multer": "^1.4.2",
    "mysql": "^2.18.1",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.2.0",
    "pdfmake": "^0.1.70",
    "tesseract.js": "^6.0.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.1",
    "esbuild": "^0.25.8",
    "javascript-obfuscator": "^4.1.1",
    "nodemon": "^2.0.0"
  }
}
