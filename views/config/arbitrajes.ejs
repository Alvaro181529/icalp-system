<%- include('../partials/header', {title, user}) %>

    <div class="px-8 py-2">
        <div class="flex items-center w-full py-2 ">
            <form id="search-arbitraje" method="get" class="w-full flex items-center">
                <input id="search" type="text" name="search" placeholder="Buscar por Codigo"
                    class="w-full px-4 py-2 border border-gray-300 rounded-l-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <button id="search-button" type="submit"
                    class="px-8 py-2 bg-blue-900 text-white rounded-r-lg hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    Buscar
                </button>
            </form>
        </div>
        <div class="overflow-x-auto shadow-md sm:rounded-lg">
            <table id="result-table" class="w-full text-sm text-left rtl:text-right text-gray-600 ">
                <thead class="text-xs text-gray-200 uppercase bg-blue-950 ">
                    <tr>
                        <th class="px-6 py-3">#</th>
                        <th class="px-6 py-3">Conciliador</th>
                        <th class="px-6 py-3">Arbitros</th>
                        <th class="px-6 py-3">N° de Sala</th>
                        <th class="px-6 py-3">Descripcion</th>
                        <th class="px-6 py-3">Estado</th>
                        <th class="px-6 py-3">Fecha</th>
                        <th class="px-6 py-3">Documento</th>
                        <th class="px-6 py-3">
                            <button id="create-arbitraje"
                                class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                Crear arbitraje
                            </button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Aquí se llenarán las filas con los resultados -->
                </tbody>
            </table>
        </div>

        <div id="pagination" class="flex flex-col items-center justify-between py-4 space-y-4">
            <div>
                <span class="text-sm text-gray-700">
                    Mostrando
                    <span id="start-item" class="font-semibold text-gray-900">
                        <span id="current-page">Página 1</span> de
                    </span>
                    <span id="item-page" class="font-semibold text-gray-900" aria-live="polite"> </span>

                </span>
            </div>
            <div class="inline-flex mt-2 xs:mt-0">
                <button id="prev-page"
                    class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-blue-800  rounded-s hover:bg-blue-900  disabled:opacity-50 disabled:cursor-not-allowed">
                    Anterior
                </button>
                <button id="next-page"
                    class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-blue-800 border-0 border-s border-blue-700 rounded-e hover:bg-blue-900 disabled:opacity-50 disabled:cursor-not-allowed">
                    Siguiente
                </button>
            </div>
        </div>
    </div>
    <dialog id="arbitrajeDialog"
        class="p-8 max-w-4xl w-full max-h-screen mx-auto bg-white rounded-lg shadow-lg overflow-y-auto">
        <form id="update-arbitrajes">
            <div class="row">
                <div class="col-6">
                    <label class="block hidden text-sm font-medium text-gray-700 mb-1" for="nCaso">N° Caso:</label>
                    <input
                        class="mt-1 p-2 w-full hidden border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                        type="number" id="nCaso" name="nCaso">
                </div>
                <div class="mb-4 col-6">
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="estado">Estado:</label>
                    <Select
                        class="mt-1 p-2 w-full border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                        type="text" id="estado" name="estado">
                        <option value="Revisado">Revisado</option>
                        <option value="" selected>Pendiente</option>
                    </Select>
                </div>
            </div>
            <div class="hidden mb-4 col-12">
                <label class="block text-sm font-medium text-gray-700 mb-1 hidden" for="estado">N° de sala:</label>
                <Select
                    class="mt-1 hidden p-2 w-full border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                    type="text" id="nCaso" name="nCaso">
                    <option value="1" selected>1</option>
                    <option value="2" >2</option>
                    <option value="3" >3</option>
                    <option value="4" >4</option>
                </Select>
            </div>
            <div class="flex justify-between space-x-4">
                <button type="button" id="close-dialog-arbitraje"
                    class="w-1/2 py-2 bg-red-500 text-white rounded-md hover:bg-red-400 focus:outline-none focus:ring-2 focus:ring-red-500">
                    Cerrar
                </button>
                <button type="submit"
                    class="w-1/2 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    Guardar
                </button>
            </div>
        </form>
    </dialog>
    <dialog id="dialog-create-post"
        class="p-8 max-w-4xl w-full max-h-screen mx-auto bg-white rounded-lg shadow-lg overflow-y-auto">
        <form class="space-y-4" id="form-arbitraje-post">
            <!-- Form Fields -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block mb-2">Conciliadores <span class="text-red-500">*</span></label>
                    <select name="nombres"
                        class="w-full px-3 py-2 bg-white rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        id="nombres">
                        <option value="S/N">S/N</option>
                        <option value="FRANCISCA MARVILA CUPANA HUANACU">FRANCISCA MARVILA CUPANA HUANACU</option>
                        <option value="VIVIANA GONZALES BELTRAN">VIVIANA GONZALES BELTRAN</option>
                        <option value="VICTOR HUGO MONTES RODRIGUEZ">VICTOR HUGO MONTES RODRIGUEZ</option>
                        <option value="VIVIANA BLANCO RIOS">VIVIANA BLANCO RIOS</option>
                        <option value="BRITTA MIREYA LOAYZA FERNANDEZ">BRITTA MIREYA LOAYZA FERNANDEZ</option>
                        <option value="JANNETH VIVIANA DEL CASTILLO CALDERON ">JANNETH VIVIANA DEL CASTILLO CALDERON </option>
                        <option value="PAOLA JACQUELINE AJNOTA MAMANI">PAOLA JACQUELINE AJNOTA MAMANI</option>
                        <option value="MARCELA SILVIA SALINAS ELIAS">MARCELA SILVIA SALINAS ELIAS</option>
                    </select>
                </div>
                <div>
                    <label class="block mb-2">Arbitros <span class="text-red-500">*</span></label>
                    <select name="apellidos"
                        class="w-full px-3 py-2 bg-white rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        id="apellidos">
                        <option value="S/N">S/N</option>
                        <option value="JOSE LUIS TUFIÑO ZUBIETA">JOSE LUIS TUFIÑO ZUBIETA</option>
                        <option value="LILIAN CATHERYN MORALES MOLLERICONA">LILIAN CATHERYN MORALES MOLLERICONA</option>
                        <option value="SERGIO ADOLFO ROCHA MENDEZ">SERGIO ADOLFO ROCHA MENDEZ</option>
                        <option value="CHRISTIAN FABIAN DAZA CAINZO">CHRISTIAN FABIAN DAZA CAINZO</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block mb-2 hidden">Correo <span class="text-red-500 ">*</span></label>
                <input type="email" name="correo"
                    class="w-full px-3 py-2 bg-white rounded border border-gray-300 hidden focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <input type="text" name="arbitraje" value="arbitraje" hidden>

            <div>
                <label class="block mb-2">Numero de sala <span class="text-red-500">*</span></label>
                <div class="flex gap-2 max-sm:flex-col">
                    <!-- <select
                        class="px-3 py-2 bg-white rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option>Bolivia</option>
                    </select> -->
                    <div class="flex w-full gap-2">
                        <input type="text" value="+591" readonly
                            class="w-20 px-3 py-2 bg-gray-100 hidden rounded border border-gray-300">
                        <input type="number " required name="celular"  maxlength="8"
                            class="w-full sm:flex-1 px-3 py-2 bg-white rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div>
                <textarea placeholder="Descripción...." rows="4" name="descripcion"
                    class="w-full px-3 py-2 bg-white rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
            </div>

            <!-- Buttons -->
            <div class="flex flex-wrap gap-4">
                <label for="file"
                    class="px-6 py-3  bg-gray-600 text-white rounded-lg cursor-pointer hover:bg-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300 ease-in-out">
                    Subir archivo PDF
                </label>
                <input type="file" id="file" accept=".pdf" class="hidden" required>

                <button type="submit" id="send-denuncia"
                    class="px-4 py-2 bg-blue-500 text-white rounded hov er:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500">Guardar</button>
            </div>
        </form>

    </dialog>
    <script defer>
        $('#form-arbitraje-post')?.addEventListener("submit", async (e) => {
            e.preventDefault();
            console.log("este es la subida de arbitraje");
            // Crear un objeto FormData para enviar el formulario con el archivo
            const formData = new FormData($('#form-arbitraje-post'));

            // Obtener el archivo del input
            const fileInput = $('#file');
            const file = fileInput.files[0];

            if (file) {
                formData.append('file', file);
            }
            try {
                const response = await fetch('/arbitraje', {
                    method: 'POST',
                    body: formData, // Enviar los datos como FormData
                });

                const responseData = await response.json();
                if (response.ok) {
                    alert('Se envió la denuncia.');
                    window.location.reload();
                }
            } catch (error) {
                alert('No se envió la denuncia. Error en la conexión');
            }
        });


        document.addEventListener("DOMContentLoaded", function () {

            let search = ""
            const dialog = $("#arbitrajeDialog");
            const resultTableBody = $("#result-table tbody");
            const prevPageButton = $("#prev-page");
            const nextPageButton = $("#next-page");
            const currentPageSpan = $("#current-page");
            const itemPage = $("#item-page");

            $('#close-dialog-arbitraje').addEventListener('click', function () {
                dialog.close();
            });
            $('#create-arbitraje').addEventListener('click', function () {
                $('#dialog-create-post').showModal();
            });
            let page = 1; let totalPages;
            const updateTable = (data, totalPages) => {
                resultTableBody.innerHTML = "";
                if (data.length > 0) {
                    data.forEach((item) => {
                        const row = document.createElement("tr");
                        const fecha = new Date(item.Fecha);

                        const fechaFormateada = fecha.toLocaleDateString("es-ES", {
                            weekday: 'long',
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        });
                        const horaFormateada = fecha.toLocaleTimeString("es-ES", {
                            hour: '2-digit',
                            minute: '2-digit',
                            hour12: true
                        });
                        row.innerHTML = `
                        <td class="px-6 py-3">${item.id.toString().padStart(5, '0')}</td>
                        <td class="px-6 py-3">${item.nombres} </td>
                        <td class="px-6 py-3">${item.apellidos}</td>
                        <td class="px-6 py-3">${item.celular}</td>
                        <td class="px-6 py-3">${item.descripcion}</td>
                        <td class="px-6 py-3">${item.estado ? item.estado : `<button class="actualizar-button bg-red-700 text-white p-3 rounded" data-caso="${item.numeroCaso ? item.numeroCaso : 'No asignado'}" data-estado="${item.estado}" data-id="${item.id}">Pendiente</button>`}</td>
                        <td class="px-6 py-3">${fechaFormateada} ${horaFormateada} </td>
                        <td class="px-6 py-3">${item.documento ? `<a class="font-medium text-blue-600 dark:text-blue-500 hover:underline text-center" target="_blank" href='/uploads/arbitrajes/${item.documento}'>${item.documento}</a>` : 'Sin documento'}</td>
                    `;
                        resultTableBody.appendChild(row);
                    });
                } else {
                    const row = document.createElement("tr");
                    row.innerHTML = `<td class="px-6 py-3" colspan="4">No se encontraron resultados</td>`;
                    resultTableBody.appendChild(row);
                }
                prevPageButton.disabled = page === 1;
                nextPageButton.disabled = page === totalPages;
                currentPageSpan.textContent = `Página ${page}`;
                itemPage.textContent = totalPages;

            };
            resultTableBody.addEventListener('click', async (e) => {
                const button = e.target;
                const dialog = $("#arbitrajeDialog");
                const id = button.getAttribute('data-id');
                const caso = button.getAttribute('data-caso');
                const estado = button.getAttribute('data-estado');
                if (button.classList.contains('actualizar-button')) {
                    await handleUpdate(caso, estado, id);
                }
            });
            handleUpdate = async (caso, estadoC, id) => {
                const form = $("#update-arbitrajes");
                const nCaso = $("#nCaso");
                const estado = $("#estado");

                nCaso.textContent = caso;
                estado.value = estadoC;

                dialog.showModal();
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();

                    const formData = new FormData(form);

                    const data = {};
                    formData.forEach((value, key) => {
                        data[key] = value;
                    });

                    const url = `/arbitrajes/${id}`;
                    const response = await fetch(url, {
                        method: 'PATCH',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(data),
                    });

                    if (response.ok) {
                        dialog.close();
                        window.location.reload();
                        console.log('Actualización exitosa');
                    } else {
                        console.error('Error al actualizar');
                    }
                });

            };

            $('#search-arbitraje').addEventListener("submit", function (e) {
                e.preventDefault();
                search = $('#search').value.trim();
                page = 1;
                fetchAndUpdateTable();
            });
            const fetchAndUpdateTable = async () => {
                const url = `/arbitraje?query=${search}&page=${page}&size=10`;

                try {
                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error("Error en la solicitud");
                    }

                    const data = await response.json();
                    if (data && data.data) {
                        updateTable(data.data, data.totalPages);

                    } else {
                        console.error("La estructura de la respuesta no es válida");
                        alert("Hubo un problema con los resultados. Intenta nuevamente.");
                    }
                } catch (error) {
                    console.error("Error al realizar la solicitud:", error);
                    alert("Hubo un problema al obtener los datos. Intenta nuevamente.");
                }
            };

            fetchAndUpdateTable();

            prevPageButton.addEventListener("click", function () {
                if (page > 1) {
                    page--;
                    fetchAndUpdateTable();
                }
            });

            nextPageButton.addEventListener("click", function () {
                page++;
                fetchAndUpdateTable();
            });
        });
    </script>

    <%- include('../partials/footer',{user}) %>