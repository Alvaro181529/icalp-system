<%- include('../partials/header', {title, user}) %>

    <div class="px-8 py-2">
        <div class="flex items-center w-full py-2 ">
            <form id="search-denuncia" method="get" class="w-full flex items-center">
                <input id="search" type="text" name="search" placeholder="Buscar por Codigo"
                    class="w-full px-4 py-2 border border-gray-300 rounded-l-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <button id="search-button" type="submit"
                    class="px-8 py-2 bg-blue-900 text-white rounded-r-lg hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    Buscar
                </button>
            </form>
        </div>
        <div class="overflow-x-auto shadow-md sm:rounded-lg">
            <table id="result-table" class="w-full text-sm text-left rtl:text-right text-gray-600 ">
                <thead class="text-xs text-gray-200 uppercase bg-blue-950 ">
                    <tr>
                        <th class="px-6 py-3">#</th>
                        <th class="px-6 py-3">Nombres</th>
                        <th class="px-6 py-3">Correo</th>
                        <th class="px-6 py-3">Celular</th>
                        <th class="px-6 py-3">Descripcion</th>
                        <th class="px-6 py-3">Estado</th>
                        <th class="px-6 py-3">Fecha</th>
                        <th class="px-6 py-3">N° caso</th>
                        <th class="px-6 py-3">N° sala</th>
                        <th class="px-6 py-3">Documento</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Aquí se llenarán las filas con los resultados -->
                </tbody>
            </table>
        </div>

        <div id="pagination" class="flex flex-col items-center justify-between py-4 space-y-4">
            <div>
                <span class="text-sm text-gray-700">
                    Mostrando
                    <span id="start-item" class="font-semibold text-gray-900">
                        <span id="current-page">Página 1</span> de
                    </span>
                    <span id="item-page" class="font-semibold text-gray-900" aria-live="polite"> </span>

                </span>
            </div>
            <div class="inline-flex mt-2 xs:mt-0">
                <button id="prev-page"
                    class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-blue-800  rounded-s hover:bg-blue-900  disabled:opacity-50 disabled:cursor-not-allowed">
                    Anterior
                </button>
                <button id="next-page"
                    class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-blue-800 border-0 border-s border-blue-700 rounded-e hover:bg-blue-900 disabled:opacity-50 disabled:cursor-not-allowed">
                    Siguiente
                </button>
            </div>
        </div>
    </div>
    <dialog id="denunciaDialog"
        class="p-8 max-w-4xl w-full max-h-screen mx-auto bg-white rounded-lg shadow-lg overflow-y-auto">
        <form id="update-denuncias">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- N° Caso -->
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="nCaso">N° Caso:</label>
                    <input
                        class="mt-1 p-2 w-full border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                        type="number" id="nCaso" name="nCaso">
                </div>

                <!-- Estado -->
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="estado">Estado:</label>
                    <select
                        class="mt-1 p-2 w-full border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                        id="estado" name="estado">
                        <option value="" selected>Pendiente</option>
                        <option value="Revisado">Revisado</option>
                    </select>
                </div>

                <!-- N° de Sala -->
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="nSala">N° de Sala:</label>
                    <select
                        class="mt-1 p-2 w-full border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                        id="nSala" name="nSala">
                        <option value="Sin Asignacion" selected>Sin Asignación</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-between space-x-4">
                <button type="button" id="close-dialog-denuncia"
                    class="w-1/2 py-2 bg-red-500 text-white rounded-md hover:bg-red-400 focus:outline-none focus:ring-2 focus:ring-red-500">
                    Cerrar
                </button>
                <button type="submit"
                    class="w-1/2 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    Guardar
                </button>
            </div>
        </form>
    </dialog>
    <script defer>
        document.addEventListener("DOMContentLoaded", function () {

            let search = ""
            const dialog = $("#denunciaDialog");
            const resultTableBody = $("#result-table tbody");
            const prevPageButton = $("#prev-page");
            const nextPageButton = $("#next-page");
            const currentPageSpan = $("#current-page");
            const itemPage = $("#item-page");

            $('#close-dialog-denuncia').addEventListener('click', function () {
                dialog.close();
            });
            let page = 1; let totalPages;
            const updateTable = (data, totalPages) => {
                resultTableBody.innerHTML = "";
                if (data.length > 0) {
                    data.forEach((item) => {
                        const row = document.createElement("tr");
                        const fecha = new Date(item.Fecha);

                        const fechaFormateada = fecha.toLocaleDateString("es-ES", {
                            weekday: 'long',
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        });
                        const horaFormateada = fecha.toLocaleTimeString("es-ES", {
                            hour: '2-digit',
                            minute: '2-digit',
                            hour12: true
                        });
                        row.innerHTML = `
                        <td class="px-6 py-3">${item.id.toString().padStart(5, '0')}</td>
                        <td class="px-6 py-3">${item.nombres} ${item.apellidos}</td>
                        <td class="px-6 py-3">${item.correo}</td>
                        <td class="px-6 py-3">${item.celular}</td>
                        <td class="px-6 py-3">${item.descripcion}</td>
                        <td class="px-6 py-3">${item.estado ? item.estado : `<button class="actualizar-button bg-red-700 text-white p-3 rounded" data-caso="${item.numeroCaso ? item.numeroCaso : 'No asignado'}" data-estado="${item.estado}" data-id="${item.id}">Pendiente</button>`}</td>
                        <td class="px-6 py-3">${fechaFormateada} ${horaFormateada} </td>
                        <td class="px-6 py-3">${item.numeroCaso ? item.numeroCaso : 'No asignado'}</td>
                        <td class="px-6 py-3">${item.numeroSala ? item.numeroSala : 'No asignado'}</td>
                        <td class="px-6 py-3">${item.documento ? `<a class="font-medium text-blue-600 dark:text-blue-500 hover:underline text-center" target="_blank" href='/uploads/denuncias/${item.documento}'>${item.documento}</a>` : 'Sin documento'}</td>
                    `;
                        resultTableBody.appendChild(row);
                    });
                } else {
                    const row = document.createElement("tr");
                    row.innerHTML = `<td class="px-6 py-3" colspan="4">No se encontraron resultados</td>`;
                    resultTableBody.appendChild(row);
                }
                prevPageButton.disabled = page === 1;
                nextPageButton.disabled = page === totalPages;
                currentPageSpan.textContent = `Página ${page}`;
                itemPage.textContent = totalPages;

            };
            resultTableBody.addEventListener('click', async (e) => {
                const button = e.target;
                const dialog = $("#denunciaDialog");
                const id = button.getAttribute('data-id');
                const caso = button.getAttribute('data-caso');
                const estado = button.getAttribute('data-estado');
                if (button.classList.contains('actualizar-button')) {
                    await handleUpdate(caso, estado, id);
                }
            });
            handleUpdate = async (caso, estadoC, id) => {
                const form = $("#update-denuncias");
                const nCaso = $("#nCaso");
                const estado = $("#estado");

                nCaso.textContent = caso;
                estado.value = estadoC;

                dialog.showModal();
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();

                    const formData = new FormData(form);

                    const data = {};
                    formData.forEach((value, key) => {
                        data[key] = value;
                    });

                    const url = `/denuncias/${id}`;
                    const response = await fetch(url, {
                        method: 'PATCH',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(data),
                    });

                    if (response.ok) {
                        dialog.close();
                        console.log('Actualización exitosa');
                    } else {
                        console.error('Error al actualizar');
                    }
                });

            };

            $('#search-denuncia').addEventListener("submit", function (e) {
                e.preventDefault();
                search = $('#search').value.trim();
                page = 1;
                fetchAndUpdateTable();
            });
            const fetchAndUpdateTable = async () => {
                const url = `/denuncia?query=${search}&page=${page}&size=10`;

                try {
                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error("Error en la solicitud");
                    }

                    const data = await response.json();
                    if (data && data.data) {
                        updateTable(data.data, data.totalPages);

                    } else {
                        console.error("La estructura de la respuesta no es válida");
                        alert("Hubo un problema con los resultados. Intenta nuevamente.");
                    }
                } catch (error) {
                    console.error("Error al realizar la solicitud:", error);
                    alert("Hubo un problema al obtener los datos. Intenta nuevamente.");
                }
            };

            fetchAndUpdateTable();

            prevPageButton.addEventListener("click", function () {
                if (page > 1) {
                    page--;
                    fetchAndUpdateTable();
                }
            });

            nextPageButton.addEventListener("click", function () {
                page++;
                fetchAndUpdateTable();
            });
        });
    </script>

    <%- include('../partials/footer',{user}) %>