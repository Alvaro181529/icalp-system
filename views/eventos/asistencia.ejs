<%- include('../partials/header'); %>
<div class="p-6 max-w-6xl mx-auto">
  <!-- Header Evento -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-6 flex justify-between items-center border-l-4 border-blue-600">
    <div>
      <h1 class="text-3xl font-bold text-gray-800"><%= evento.Nombre %></h1>
      <p class="text-gray-600 mt-1">
        <i class="fa-regular fa-calendar mr-2"></i> <%= evento.Fecha.toLocaleDateString() %>
        <% if(evento.HoraInicio) { %> | <i class="fa-regular fa-clock mx-2"></i> <%= evento.HoraInicio %> <% } %>
      </p>
    </div>
    <div class="text-right">
      <span class="block text-sm text-gray-500 mb-1">Estado</span>
      <span class="px-4 py-1 rounded-full font-bold text-sm uppercase <%= evento.Estado === 'activo' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
        <%= evento.Estado %>
      </span>
      <div class="mt-4">
        <a href="/eventos" class="text-blue-600 hover:underline text-sm"><i class="fa-solid fa-arrow-left mr-1"></i> Volver a Eventos</a>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Panel Izquierdo: Buscador y Registro -->
    <div class="bg-white rounded-lg shadow-md p-6 h-fit">
      <h2 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2"><i class="fa-solid fa-user-check mr-2"></i> Registrar Asistencia</h2>
      
      <% if (evento.Estado !== 'activo') { %>
        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-4">
          <div class="flex">
            <div class="flex-shrink-0"><i class="fa-solid fa-exclamation-triangle text-yellow-400"></i></div>
            <div class="ml-3"><p class="text-sm text-yellow-700">El evento está finalizado. No se puede registrar más asistencia.</p></div>
          </div>
        </div>
      <% } else { %>
        
        <!-- Buscador -->
        <div class="mb-6">
          <label class="block text-gray-700 font-bold mb-2 text-sm" for="searchInput">
            Buscar colegiado por CI o Matrícula:
          </label>
          <div class="relative">
            <input type="text" id="searchInput" class="shadow appearance-none border rounded-lg w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 text-lg" placeholder="Ej: 1234567 o 4501" autocomplete="off">
            <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
              <i class="fa-solid fa-search text-gray-400"></i>
            </div>
          </div>
          <div id="searchSpinner" class="hidden mt-2 text-blue-600 text-sm">
            <i class="fa-solid fa-circle-notch fa-spin mr-1"></i> Buscando...
          </div>
        </div>

        <!-- Resultados de búsqueda -->
        <div id="resultadosBusqueda" class="space-y-3 mb-6"></div>

        <!-- Alerta de éxito/error -->
        <div id="alertMessage" class="hidden rounded-md p-4 mb-4"></div>

      <% } %>
    </div>

    <!-- Panel Derecho: Últimos Ingresos (Tiempo Real) -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex justify-between items-center border-b pb-2 mb-4">
        <h2 class="text-xl font-bold text-gray-800"><i class="fa-solid fa-list mr-2"></i> Últimos Ingresos</h2>
        <button onclick="cargarUltimosIngresos()" class="text-blue-500 hover:text-blue-700 text-sm" title="Actualizar lista">
          <i class="fa-solid fa-sync-alt"></i> Actualizar
        </button>
      </div>
      
      <div class="overflow-y-auto max-h-[500px]">
        <table class="min-w-full leading-normal">
          <thead>
            <tr>
              <th class="px-3 py-2 border-b-2 border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase">Hora</th>
              <th class="px-3 py-2 border-b-2 border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase">Colegiado</th>
              <th class="px-3 py-2 border-b-2 border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase">CI/Matr.</th>
            </tr>
          </thead>
          <tbody id="tablaIngresos">
            <tr><td colspan="3" class="text-center py-4 text-gray-500"><i class="fa-solid fa-circle-notch fa-spin"></i> Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  const eventoId = <%= evento.EventoId %>;
  const searchInput = document.getElementById('searchInput');
  const resultadosContainer = document.getElementById('resultadosBusqueda');
  const searchSpinner = document.getElementById('searchSpinner');
  const alertMessage = document.getElementById('alertMessage');
  const tablaIngresos = document.getElementById('tablaIngresos');
  
  let searchTimeout = null;

  // Cargar ingresos iniciales
  cargarUltimosIngresos();

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const valor = e.target.value.trim();
      
      clearTimeout(searchTimeout);
      
      if (valor.length < 3) {
        resultadosContainer.innerHTML = '';
        return;
      }

      searchSpinner.classList.remove('hidden');
      
      searchTimeout = setTimeout(() => {
        buscarColegiado(valor);
      }, 500); // debounce 500ms
    });

    // Permitir buscar apretando Enter directamente
    searchInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        clearTimeout(searchTimeout);
        const valor = e.target.value.trim();
        if (valor.length >= 3) {
          searchSpinner.classList.remove('hidden');
          buscarColegiado(valor);
        }
      }
    });
  }

  async function buscarColegiado(termino) {
    try {
      const res = await fetch(`/api/colegiados/buscar?termino=${termino}`);
      const data = await res.json();
      
      searchSpinner.classList.add('hidden');
      resultadosContainer.innerHTML = '';
      
      if (data.length === 0) {
        resultadosContainer.innerHTML = '<div class="p-3 bg-gray-50 text-gray-500 text-center rounded border">No se encontró ningún colegiado.</div>';
        return;
      }

      data.forEach(col => {
        const estadoColor = col.Estado === 'Activo' ? 'text-green-600' : 'text-red-600';
        const imgPath = col.Foto ? `/uploads/imagenes/${col.Foto}` : '/public/img/imageDefault.png';
        
        const card = document.createElement('div');
        card.className = 'border rounded-lg p-4 flex items-center justify-between bg-gray-50 hover:bg-blue-50 transition-colors shadow-sm';
        card.innerHTML = `
          <div class="flex items-center space-x-6">
            <img class="w-24 h-24 rounded-xl object-cover border-2 border-blue-200 shadow-sm" src="${imgPath}" alt="Foto">
            <div>
              <p class="font-bold text-gray-900 text-lg">${col.Nombres} ${col.Paterno} ${col.Materno || ''}</p>
              <div class="text-sm text-gray-600 mt-1">
                <span class="mr-3"><b>CI:</b> ${col.NumeroCI}</span>
                <span class="mr-3"><b>Mat:</b> ${col.Matricula}</span>
                <span class="font-semibold px-2 py-1 rounded bg-gray-100 ${estadoColor}">${col.Estado}</span>
              </div>
            </div>
          </div>
          <button onclick="registrarAsistencia(${col.ColegiadoId}, '${col.Nombres} ${col.Paterno}')" 
                  class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-bold shadow transition-colors flex-shrink-0">
            <i class="fa-solid fa-check mr-1"></i> Ingreso
          </button>
        `;
        resultadosContainer.appendChild(card);
      });

    } catch (error) {
      console.error(error);
      searchSpinner.classList.add('hidden');
      resultadosContainer.innerHTML = '<div class="p-3 bg-red-50 text-red-600 rounded">Error de conexión al buscar.</div>';
    }
  }

  async function registrarAsistencia(colegiadoId, nombre) {
    try {
      const res = await fetch('/api/eventos/asistencia', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ eventoId, colegiadoId })
      });
      const data = await res.json();

      if (data.success) {
        mostrarAlerta('success', `¡Asistencia registrada para <b>${nombre}</b>!`);
        searchInput.value = '';
        resultadosContainer.innerHTML = '';
        searchInput.focus();
        cargarUltimosIngresos(); // Actualizar tabla
      } else {
        // Probablemente duplicado
        mostrarAlerta('warning', data.message || 'Error al registrar.');
      }
    } catch (error) {
      console.error(error);
      mostrarAlerta('error', 'Error de conexión al registrar asistencia.');
    }
  }

  function mostrarAlerta(tipo, html) {
    alertMessage.classList.remove('hidden', 'bg-green-100', 'text-green-800', 'bg-yellow-100', 'text-yellow-800', 'bg-red-100', 'text-red-800');
    
    if (tipo === 'success') {
      alertMessage.classList.add('bg-green-100', 'text-green-800');
      alertMessage.innerHTML = `<i class="fa-solid fa-check-circle mr-2"></i> ${html}`;
    } else if (tipo === 'warning') {
      alertMessage.classList.add('bg-yellow-100', 'text-yellow-800');
      alertMessage.innerHTML = `<i class="fa-solid fa-exclamation-triangle mr-2"></i> ${html}`;
    } else {
      alertMessage.classList.add('bg-red-100', 'text-red-800');
      alertMessage.innerHTML = `<i class="fa-solid fa-times-circle mr-2"></i> ${html}`;
    }
    
    // Ocultar después de 4 segundos
    setTimeout(() => {
      alertMessage.classList.add('hidden');
    }, 4000);
  }

  async function cargarUltimosIngresos() {
    try {
      const res = await fetch(`/api/eventos/${eventoId}/ultimos-ingresos`);
      const data = await res.json();
      
      tablaIngresos.innerHTML = '';
      
      if (data.length === 0) {
        tablaIngresos.innerHTML = '<tr><td colspan="3" class="text-center py-4 text-gray-500">Aún no hay ingresos registrados.</td></tr>';
        return;
      }

      data.forEach(ingreso => {
        const hora = new Date(ingreso.FechaIngreso).toLocaleTimeString();
        const imgPath = ingreso.Foto ? `/uploads/imagenes/${ingreso.Foto}` : '/public/img/imageDefault.png';
        
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="px-3 py-3 border-b border-gray-200 text-sm text-gray-900 font-semibold">${hora}</td>
          <td class="px-3 py-3 border-b border-gray-200 text-sm text-gray-900">
            <div class="flex items-center space-x-3">
              <img class="w-8 h-8 rounded-full object-cover border border-gray-200" src="${imgPath}" alt="Foto">
              <div>
                ${ingreso.Nombres} ${ingreso.Paterno}
                <div class="text-xs text-gray-500">Por: ${ingreso.RegistradoPor}</div>
              </div>
            </div>
          </td>
          <td class="px-3 py-3 border-b border-gray-200 text-sm text-gray-600">
            C: ${ingreso.NumeroCI}<br>
            M: ${ingreso.Matricula}
          </td>
        `;
        tablaIngresos.appendChild(tr);
      });
    } catch (error) {
      console.error('Error al cargar ingresos:', error);
    }
  }
</script>

<%- include('../partials/footer'); %>
