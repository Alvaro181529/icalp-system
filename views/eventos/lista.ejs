<%- include('../partials/header'); %>
<div class="p-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Gestión de Eventos</h1>
    <% if (user && user.roles.includes('Administrador')) { %>
    <button onclick="document.getElementById('modal-crear').showModal()" 
            class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg flex items-center">
      <i class="fa-solid fa-plus mr-2"></i> Nuevo Evento
    </button>
    <% } %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-x-auto">
    <table class="min-w-full leading-normal">
      <thead>
        <tr>
          <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
            Nombre del Evento
          </th>
          <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
            Fecha y Hora
          </th>
          <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
            Asistentes
          </th>
          <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
            Estado
          </th>
          <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
            Acciones
          </th>
        </tr>
      </thead>
      <tbody>
        <% if (eventos.length === 0) { %>
          <tr><td colspan="5" class="px-5 py-5 text-center text-gray-500">No hay eventos registrados.</td></tr>
        <% } %>
        <% eventos.forEach(evento => { %>
          <tr>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <p class="text-gray-900 whitespace-no-wrap font-bold"><%= evento.Nombre %></p>
              <p class="text-gray-500 whitespace-no-wrap text-xs"><%= evento.Descripcion || 'Sin descripción' %></p>
            </td>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <p class="text-gray-900 whitespace-no-wrap">
                <i class="fa-regular fa-calendar mr-1"></i> <%= evento.Fecha.toLocaleDateString() %>
              </p>
              <p class="text-gray-500 whitespace-no-wrap">
                <i class="fa-regular fa-clock mr-1"></i> <%= evento.HoraInicio || 'No definida' %>
              </p>
            </td>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <span class="inline-flex items-center justify-center px-3 py-1 text-sm font-bold leading-none text-blue-100 bg-blue-600 rounded-full">
                <%= evento.TotalAsistentes %>
              </span>
            </td>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <span class="relative inline-block px-3 py-1 font-semibold <%= evento.Estado === 'activo' ? 'text-green-900' : 'text-red-900' %> leading-tight">
                <span aria-hidden class="absolute inset-0 <%= evento.Estado === 'activo' ? 'bg-green-200' : 'bg-red-200' %> opacity-50 rounded-full"></span>
                <span class="relative capitalize"><%= evento.Estado %></span>
              </span>
            </td>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <div class="flex space-x-2">
                <a href="/evento/asistencia/<%= evento.EventoId %>" class="text-blue-600 hover:text-blue-900 bg-blue-100 hover:bg-blue-200 px-3 py-1 rounded transition-colors">
                  <i class="fa-solid fa-clipboard-user mr-1"></i> Asistencia
                </a>
                
                <% if (user && user.roles.includes('Administrador')) { %>
                  <% if (evento.Estado === 'activo') { %>
                    <button onclick="cambiarEstado(<%= evento.EventoId %>, 'finalizado')" class="text-orange-600 hover:text-orange-900 bg-orange-100 hover:bg-orange-200 px-3 py-1 rounded transition-colors">
                      <i class="fa-solid fa-flag-checkered mr-1"></i> Finalizar
                    </button>
                  <% } else { %>
                    <button onclick="cambiarEstado(<%= evento.EventoId %>, 'activo')" class="text-green-600 hover:text-green-900 bg-green-100 hover:bg-green-200 px-3 py-1 rounded transition-colors">
                      <i class="fa-solid fa-play mr-1"></i> Reabrir
                    </button>
                  <% } %>
                  
                  <a href="/evento/<%= evento.EventoId %>/reporte/pdf" class="text-red-600 hover:text-red-900 bg-red-100 hover:bg-red-200 px-3 py-1 rounded transition-colors" title="Descargar PDF">
                    <i class="fa-solid fa-file-pdf"></i>
                  </a>
                  <a href="/evento/<%= evento.EventoId %>/reporte/excel" class="text-green-600 hover:text-green-900 bg-green-100 hover:bg-green-200 px-3 py-1 rounded transition-colors" title="Descargar Excel">
                    <i class="fa-solid fa-file-excel"></i>
                  </a>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal Crear Evento -->
<dialog id="modal-crear" class="p-0 rounded-lg shadow-xl backdrop:bg-black backdrop:bg-opacity-50 w-full max-w-md">
  <div class="bg-white p-6">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-bold text-gray-900">Crear Nuevo Evento</h3>
      <button onclick="document.getElementById('modal-crear').close()" class="text-gray-400 hover:text-gray-600">
        <i class="fa-solid fa-times text-xl"></i>
      </button>
    </div>
    
    <form action="/api/eventos" method="POST">
      <div class="mb-4">
        <label class="block text-gray-700 text-sm font-bold mb-2" for="nombre">Nombre del Evento *</label>
        <input required type="text" id="nombre" name="nombre" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      
      <div class="mb-4">
        <label class="block text-gray-700 text-sm font-bold mb-2" for="descripcion">Descripción</label>
        <textarea id="descripcion" name="descripcion" rows="3" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
      </div>
      
      <div class="flex gap-4 mb-6">
        <div class="w-1/2">
          <label class="block text-gray-700 text-sm font-bold mb-2" for="fecha">Fecha *</label>
          <input required type="date" id="fecha" name="fecha" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div class="w-1/2">
          <label class="block text-gray-700 text-sm font-bold mb-2" for="horaInicio">Hora de Inicio</label>
          <input type="time" id="horaInicio" name="horaInicio" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
      </div>
      
      <div class="flex items-center justify-end">
        <button type="button" onclick="document.getElementById('modal-crear').close()" class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded mr-2">
          Cancelar
        </button>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
          Guardar Evento
        </button>
      </div>
    </form>
  </div>
</dialog>

<script>
  // Poner fecha de hoy por defecto en el input de fecha
  document.getElementById('fecha').valueAsDate = new Date();

  async function cambiarEstado(id, nuevoEstado) {
    if (!confirm(`¿Seguro que deseas ${nuevoEstado === 'finalizado' ? 'finalizar' : 'reabrir'} este evento?`)) return;
    
    try {
      const res = await fetch(`/api/eventos/${id}/estado`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ estado: nuevoEstado })
      });
      
      if (res.ok) {
        window.location.reload();
      } else {
        alert('Error al actualizar el estado');
      }
    } catch (error) {
      console.error(error);
      alert('Error de conexión');
    }
  }
</script>

<%- include('../partials/footer'); %>
