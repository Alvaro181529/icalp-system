    <script defer>

      const searchMat = $("#searchMat");
      const searchUsers = $("#searchCol");
      const searchFormHeader = $("#search-form-header");
      const dialogSearch = $('#dialog-search')
      const cerrarDialogSearch = $('#cerrar-dialog')
      const formDenuncia = $('#form-denuncia')
      $('#search-denuncia').addEventListener('submit', (e) => {
        e.preventDefault();
        const searchValue = search.value.trim();
        if (!searchValue) {
          alert("Por favor, ingrese un término de búsqueda.");
          return;
        }
        const searchUrl = `/denuncia-open?query=${encodeURIComponent(searchValue)}`;
        fetch(searchUrl)
          .then((response) => {
            if (!response.ok) {
              throw new Error("Error en la búsqueda");
            }
            return response.json();
          })
          .then((data) => {
            const fechaOriginal = data.data[0].Fecha;
            const fechaFormateada = fechaOriginal ? fechaOriginal.split('T')[0] : 'Sin fecha';
            $('#tiquet-dialog').showModal()
            $('#number-tiquet').textContent = data.data[0].id.toString().padStart(5, '0');
            $('#number-date').textContent = fechaFormateada;
            $('#contenido-tiquet').textContent = data.data[0].estado ? data.data[0].estado : 'Denuncia Pendiente';
            $('#resultado-tiquet').textContent = data.data[0].estado ? 'Favor pasar a tribunal de honor en Calle YANACOCHA Nº 630 Piso 3' : '';
          })
          .catch((error) => {
            console.error("Error en la búsqueda:", error);
            alert("Hubo un problema al realizar la búsqueda. Intenta nuevamente.");
          });
      })
      $('#cerrar-dialog-tiquet').addEventListener('click', () => {
        $('#tiquet-dialog').close()
      })
      formDenuncia?.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Crear un objeto FormData para enviar el formulario con el archivo
        const formData = new FormData(formDenuncia);

        // Obtener el archivo del input
        const fileInput = $('#file');
        const file = fileInput.files[0];

        if (file) {
          formData.append('file', file);
        }
        try {
          const response = await fetch('/denuncia', {
            method: 'POST',
            body: formData, // Enviar los datos como FormData
          });

          const responseData = await response.json();
          if (response.ok) {
            if (responseData.message) {
              alert(responseData.message);
              return;
            }
            $('#tiquet-dialog').showModal()
            $('#number-tiquet').textContent = responseData.toString().padStart(5, '0');
            $('#contenido-tiquet').textContent = 'Denuncia enviada';
          } else {
            $('#contenido-tiquet').textContent = 'Error al enviar la denuncia';
          }
        } catch (error) {
          alert('No se envió la denuncia. Error en la conexión');
        }
      });
      searchFormHeader?.addEventListener("submit", async (e) => {
        e.preventDefault();


        const searchValueMat = searchMat.value.trim();
        const searchValueM = searchMaterno.value.trim();
        const searchValueP = searchPaterno.value.trim();
        let searchValue = searchCol.value.trim();


        if (searchValueMat && searchValue) {
          searchMat.value = '';
        }


        if (searchValueMat && !searchValue) {

          searchValue = searchValueMat;
        }


        if (!searchValue && !searchValueM && !searchValueP && !searchMat) {
          alert("Por favor, ingrese un término de búsqueda.");
          return;
        }
        dialogSearch.showModal()

        const url = `search?search=${encodeURIComponent(searchValue)}&paterno=${encodeURIComponent(searchValueP)}&materno=${encodeURIComponent(searchValueM)}`;

        try {

          const response = await fetch(url);
          if (!response.ok) {
            throw new Error("Error en la búsqueda");
          }

          const data = await response.json();
          const resultContainer = document.querySelector("#result-list");
          resultContainer.innerHTML = "";
          if (data.result.users.length > 0) {
            data.result.users.forEach((colegiado) => {
              const listItem = document.createElement("li");
              listItem.classList.add("w-full");
              listItem.innerHTML = `
   <div class="cards-container-resultado">
      <!-- Nueva card -->
      <div class="card-resultado">
         <div class="card-header-resultado">
            <h2>${colegiado.Nombres} ${colegiado.Paterno} ${colegiado.Materno}</h2>
         </div>

         <div class="card-content">
            <div class="card-image-section">
               <div class="card-image-resultado">
                  <img
                     src="${colegiado.Foto ? '/uploads/imagenes/' + colegiado.Foto : '/public/img/imageDefault.png'}"
                     alt="Foto de: ${colegiado.Nombres} "
                     class="w-32 h-32 object-cover"
                  />
               </div>
            </div>

            <div class="card-info-section">
               <div class="info-group">
                  <div class="info-item">
                     <span class="info-label">Matrícula:</span>
                     <span class="info-value">${colegiado.Matricula.toString().padStart(5, '0')}</span>
                  </div>
                  <div class="info-item">
                     <span class="info-label">Conalab:</span>
                     <span class="info-value">${colegiado.MatriculaConalab || 'S/N'}</span>
                  </div>
                  <div class="info-item">
                     <span class="info-label">Registro:</span>
                     <span class="info-value">${new Date(colegiado.FechaMatriculacionAlColegio).toLocaleDateString()}</span>
                  </div>
               </div>

               <div class="section-divider"></div>

               <div class="info-group">
                  <p class="section-title">Información de Contacto</p>
                  <div class="info-item">
                     <span class="info-label">Dirección:</span>
                     <span class="info-value">${colegiado.DireccionOficina || 'S/N'}</span>
                  </div>
                  <div class="info-item">
                     <span class="info-label">Teléfono:</span>
                     <span class="info-value">${colegiado.TelefonoOficina || 'S/N'}</span>
                  </div>
               </div>
            </div>
         </div>

         <div class="card-footer-resultado">
            <span class=' ${colegiado.Estado === 'Suspendido' || colegiado.Estado === "Inactivo" ? 'bg-red-200 text-red-800 ' : 'bg-green-100 text-green-800 '} px-4 py-2 rounded-xl'>
               ${colegiado.Estado}
            </span>
            <% if (user) { %>
               <a class="font-medium text-yellow-700 dark:text-blue-500 hover:underline text-center" href="colegiado/${colegiado.ColegiadoId}">Ir al colegiado</a>
            <% }%>
         </div>
      </div>
   </div>
`;
              resultContainer.appendChild(listItem);
            });
          } else {
            const listItem = document.createElement("li");
            listItem.innerHTML = `<h2 class="text-gray-500">No se encontraron resultados </h2>`
            resultContainer.appendChild(listItem);
          }
        } catch (error) {
          console.error("Error en la búsqueda:", error);
          alert("Hubo un problema al realizar la búsqueda. Intenta nuevamente.");
        }
      });
      cerrarDialogSearch.addEventListener('click', () => {
        dialogSearch.close()
      })


      // $('#imprimir-tiquet').addEventListener('click', function imprimirPagina() {
      //   var contenido = $('#tiquet-dialog').innerHTML;
      //   var ventanaImpresion = window.open('', '', 'width=800,height=600');

      //   // Escribimos la estructura inicial del documento
      //   ventanaImpresion.document.open();
