            class="w-full h-full object-cover rounded-lg">
        </div>

        <div class="md:w-2/3 p-6 bg-white rounded-lg shadow-lg">
          <form class="space-y-4" id="form-denuncia">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-gray-700 mb-2">Nombres <span class="text-red-500">*</span></label>
                <input type="text" required name="nombres"
                  class="w-full px-3 py-2 bg-gray-100 rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-gray-700 mb-2">Apellidos <span class="text-red-500">*</span></label>
                <input type="text" required name="apellidos"
                  class="w-full px-3 py-2 bg-gray-100 rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
              </div>
            </div>

            <div>
              <label class="block text-gray-700 mb-2">Correo <span class="text-red-500">*</span></label>
              <input type="email" required name="correo"
                class="w-full px-3 py-2 bg-gray-100 rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
