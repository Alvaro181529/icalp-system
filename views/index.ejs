    <dialog id="tiquet-dialog"
      class="w-full max-w-md bg-white rounded-lg shadow-2xl border-0 p-0 fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-50 open:flex">
      <div class="min-h-screen bg-gray-100 flex items-center justify-center p-4">
        <div class="flex flex-col w-full">
          <div class="flex justify-between items-start p-6 pb-4">
