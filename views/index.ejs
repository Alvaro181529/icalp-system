  <div class="bg-black overflow-hidden mx-auto">
    <div class="container mx-auto px-8 py-8">
      <h1 class="text-white text-4xl font-bold mb-8">DENUNCIAS</h1>
      <div class="flex flex-col md:flex-row">
        <div class="md:w-1/3">
