<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ModalPresentacion con Video</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Asegura que el iframe se ajuste bien a cualquier tamaño */
        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        /* Estilos personalizados para el modal */
        dialog {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        /* Fondo oscuro detrás del modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.6); /* Fondo oscuro con transparencia */
            z-index: 1;
            transition: opacity 0.3s ease; /* Transición suave al mostrar/ocultar */
            opacity: 0;
        }

        /* Cuando se muestra el overlay */
        .modal-overlay.show {
            opacity: 1;
        }


        .close-btn:hover {
            background-color: #C53030; /* Rojo oscuro */
        }

        /* Asegura que el modal se vea bien en dispositivos móviles */
        @media (max-width: 768px) {
            dialog {
                width: 90%;
                height: 80%;
                max-height: 90%; /* Para asegurar que no sea demasiado alto */
            }
        }
    </style>
</head>

<body class="bg-gray-100">

    <!-- ModalPresentacion -->
    <dialog id="modalPresentacion" 
        class="w-4/5 max-w-3xl sm:h-3/4 h-56 bg-black rounded-lg shadow-lg p-0 overflow-hidden relative z-10"
        aria-labelledby="modalTitle" role="dialog" aria-hidden="true">

        <div class="bg-gradient-to-r from-red-500 via-yellow-500 to-green-500 h-10 sm:h-16 text-white text-start w-full p-4 rounded-t-lg">
        </div>

        <button class="absolute top-1 sm:top-4 right-2 text-white bg-red-500 hover:bg-red-700 px-1  sm:p-2 rounded-full text-sm sm:text-2xl" onclick="closeModalPresentacion()">×</button>
        <!-- Video -->
        <video id="videoElement" width="100%" height="100%" controls  poster="/public/felicidades-bolivia.png">
            <source src="/public/video-bicentenario.mp4" type="video/mp4">
            Tu navegador no soporta la etiqueta de video.
        </video>

    </dialog>

    <!-- Overlay oscuro -->
    <div id="overlay" class="modal-overlay" aria-hidden="true"></div>
    <script>
        // Función para abrir el modalPresentacion cuando la página cargue, solo en agosto
        window.onload = function () {
            const currentMonth = new Date().getMonth(); // Obtener el mes actual (0-11)

            // Verificar si es agosto (mes 7)
            if (currentMonth === 7) {
                const modal = document.getElementById('modalPresentacion');
                modal.showModal(); // Mostrar el modalPresentacion solo en agosto

                const overlay = document.getElementById('overlay');
                overlay.classList.remove('hidden'); // Mostrar el fondo oscuro
                setTimeout(() => overlay.classList.add('show'), 10); // Agregar clase para animación
            }
        };

        // Función para reproducir el video con sonido
        function playVideo() {
            const videoElement = document.getElementById('videoElement');
            const playButton = document.getElementById('playButton');

            // Reproducir video con sonido
            videoElement.play().catch(function (error) {
                console.error('Error al intentar reproducir el video:', error);
            });

            // Ocultar el botón de reproducción
            playButton.style.display = 'none';
        }

        // Función para cerrar el modalPresentacion
        function closeModalPresentacion() {
            const modal = document.getElementById('modalPresentacion');
            modal.close(); // Cerrar el modalPresentacion

            const overlay = document.getElementById('overlay');
            overlay.classList.remove('show'); // Quitar clase de animación
            setTimeout(() => overlay.classList.add('hidden'), 300); // Ocultar el fondo oscuro después de la animación

            // Pausar el video y reiniciar
            const videoElement = document.getElementById('videoElement');
            videoElement.pause();
            videoElement.currentTime = 0; // Reiniciar al inicio
            videoElement.controls = false; // Esconder los controles del video
        }
    </script>

</body>

</html>
